# ClippedAI Local Development Environment
# Copy this file to local.env and fill in your values.
# This file is gitignored — never commit local.env.

# ── Required: API Keys ─────────────────────────────────────────────────────────
ASSEMBLYAI_KEY=your_assemblyai_key_here
GROQ_KEY=your_groq_key_here

# ── Auth token (must match PROCESS_VIDEO_ENDPOINT_AUTH in frontend/.env.local) ─
LOCAL_DEV_AUTH_TOKEN=local-dev-secret

# ── Where to save finished clips (auto-detected if not set) ───────────────────
# FRONTEND_PUBLIC_DIR=/Users/YOUR_USERNAME/ClippedAI/frontend/public

# ── Webhook target (defaults to localhost:3000) ───────────────────────────────
# WEBHOOK_URL=http://localhost:3000/api/webhooks/modal
