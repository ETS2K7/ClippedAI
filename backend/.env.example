# AssemblyAI API key for transcription + speaker diarization
ASSEMBLYAI_KEY=

# Groq API key for viral clip selection
GROQ_KEY=

# AWS S3 bucket for video storage
S3_BUCKET_NAME=clippedai-7137
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bearer token for authenticating frontend -> backend requests
AUTH_TOKEN=

# Apify API token for YouTube video downloads (used by main.py)
APIFY_TOKEN=

# Optional — Modal secret `clippedai-secret` should include these if not using code defaults
