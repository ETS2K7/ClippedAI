# ClippedAI — Production Environment Variables
# Copy this file to .env.production and fill in all values before deploying

NODE_ENV=production

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Docker service name "db" resolves inside compose)
DATABASE_URL=postgresql://clippedai:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/clippedai

# ── App ───────────────────────────────────────────────────────────────────────
BASE_URL=https://clippedai.app

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=REPLACE_WITH_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
AWS_REGION=us-east-1
S3_BUCKET_NAME=clippedai-7137

# ── Modal Backend ─────────────────────────────────────────────────────────────
PROCESS_VIDEO_ENDPOINT=https://ebelseiko--clippedai-clippedai-process-video.modal.run
PROCESS_VIDEO_ENDPOINT_AUTH=REPLACE_WITH_MODAL_AUTH_TOKEN
