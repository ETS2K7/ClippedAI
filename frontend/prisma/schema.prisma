generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String         @unique
  emailVerified  DateTime?
  /// Nullable so OAuth providers (Google, GitHub) can create accounts without a password
  password       String?
  image          String?
  /// Grants access to admin-only routes and the /admin dashboard
  isAdmin        Boolean        @default(false)
  /// Caption / font preferences — persisted by PATCH /api/preferences
  prefFontFamily String         @default("TikTokSans-Regular")
  prefFontSize   Int            @default(24)
  prefFontColor  String         @default("#FFFFFF")
  accounts       Account[]
  clips          Clip[]
  sessions       Session[]
  uploadedFiles  UploadedFile[]
}

model UploadedFile {
  id          String   @id @default(cuid())
  s3Key       String
  displayName String?
  uploaded    Boolean  @default(false)
  status      String   @default("queued")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  clips       Clip[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([s3Key])
  @@index([userId, createdAt])
  @@index([status])
  @@index([userId, status])
}

model Clip {
  id             String        @id @default(cuid())
  s3Key          String
  thumbnailKey   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  uploadedFileId String?
  userId         String
  thumbnailKeys  Json?
  uploadedFile   UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([s3Key])
  @@unique([s3Key])
  @@index([userId])
  @@index([uploadedFileId])
  @@index([createdAt])
  @@index([uploadedFileId, createdAt])
  @@index([userId, createdAt])
}

/// Required by NextAuth Prisma adapter for email verification flows
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
