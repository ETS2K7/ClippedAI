# ClippedAI Frontend Environment Variables
# Copy this file to `.env` and fill in the values.
#
# The schema is validated by `/src/env.js` using @t3-oss/env-nextjs.
# When adding additional environment variables, update that file too.

# ─── Authentication ──────────────────────────────────────────────────────
# Generate a new secret: npx auth secret
AUTH_SECRET=""

# ─── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection string (production uses PostgreSQL, not SQLite)
DATABASE_URL="postgresql://postgres:password@localhost:5432/clippedai"

# ─── AWS S3 ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="clippedai-7137"

# ─── Video Processing (Modal backend) ────────────────────────────────────
PROCESS_VIDEO_ENDPOINT=""
PROCESS_VIDEO_ENDPOINT_AUTH=""

# ─── Base URL ────────────────────────────────────────────────────────────
BASE_URL="http://localhost:3000"

# ─── Stripe (optional — not needed for self-hosted) ──────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Analytics (optional) ───────────────────────────────────────────────
# NEXT_PUBLIC_DATAFAST_WEBSITE_ID=""
# NEXT_PUBLIC_DATAFAST_DOMAIN=""

# ─── Self-hosting ───────────────────────────────────────────────────────
# Set to "false" to enable monetization
# NEXT_PUBLIC_SELF_HOST="true"
