# ClippedAI Frontend Environment Variables
# Copy this file to `.env` and fill in the values.
#
# The schema is validated by `/src/env.js` using @t3-oss/env-nextjs.
# When adding additional environment variables, update that file too.

# ─── Authentication ──────────────────────────────────────────────────────
# Generate a new secret: npx auth secret
AUTH_SECRET=""

# ─── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection string (production uses PostgreSQL, not SQLite)
DATABASE_URL="postgresql://user:password@localhost:5432/clippedai"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Modal Backend ───────────────────────────────────────────────────────
PROCESS_VIDEO_ENDPOINT="https://your-modal-app.modal.run"
PROCESS_VIDEO_ENDPOINT_AUTH="your-auth-token-here" # Updated to secure token

# ─── AWS S3 ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="clippedai-ap-south-1"

# ─── CloudFront CDN (optional - set to enable CDN) ──────────────────────
NEXT_PUBLIC_CLOUDFRONT_DOMAIN="your-cloudfront-domain.cloudfront.net"

# ─── API ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ─── Base URL ────────────────────────────────────────────────────────────
BASE_URL="http://localhost:3000"

# ─── Stripe (optional — not needed for self-hosted) ──────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Analytics (optional) ───────────────────────────────────────────────
# NEXT_PUBLIC_DATAFAST_WEBSITE_ID=""
# NEXT_PUBLIC_DATAFAST_DOMAIN=""

# ─── Self-hosting ───────────────────────────────────────────────────────
# Set to "false" to enable monetization
# NEXT_PUBLIC_SELF_HOST="true"

# ─── Redis Caching (optional - for performance optimization) ─────────────
# Upstash Redis for rate limiting and query caching
# UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# ─── Dodo Payments ───────────────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=""
DODO_WEBHOOK_SECRET=""

# Dodo Product IDs
DODO_PLAN_STARTER=""
DODO_PLAN_PRO=""
DODO_PLAN_PRO_FOUNDING=""
DODO_CREDITS_100=""
DODO_CREDITS_250=""
DODO_CREDITS_500=""

# Public Dodo Product IDs
NEXT_PUBLIC_DODO_PLAN_STARTER=""
NEXT_PUBLIC_DODO_PLAN_PRO=""
NEXT_PUBLIC_DODO_PLAN_PRO_FOUNDING=""
NEXT_PUBLIC_DODO_CREDITS_100=""
NEXT_PUBLIC_DODO_CREDITS_250=""
NEXT_PUBLIC_DODO_CREDITS_500=""
